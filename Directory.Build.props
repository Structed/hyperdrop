<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!--
      Do not enable InvariantGlobalization here. WPF resolves FrameworkElement.Language through
      XmlLanguage, which needs a specific culture for "en-us"; in invariant mode that lookup throws
      "Cannot find non-neutral culture related to 'en-us'" and the app dies before its first window.
    -->
  </PropertyGroup>

</Project>
