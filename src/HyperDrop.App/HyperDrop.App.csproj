<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is pulled in purely for NotifyIcon (tray balloon) and the folder browser. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HyperDrop.ico</ApplicationIcon>
    <AssemblyName>HyperDrop</AssemblyName>
    <RootNamespace>HyperDrop.App</RootNamespace>
    <!--
      Surfaced by the About dialog and by the file properties of HyperDrop.exe. Version is
      deliberately absent: it comes from Directory.Build.props for local builds and from
      release.yml's -p:Version= for published ones. Setting it here would pin every build to one
      number and is exactly what used to make the About dialog read "Version 1.0.0".
    -->
    <Product>HyperDrop</Product>
    <Description>Drag and drop files and folders into a running Hyper-V virtual machine.</Description>
    <Authors>Johannes Ebner</Authors>
    <Company>Johannes Ebner</Company>
    <Copyright>Copyright (c) 2026 Johannes Ebner</Copyright>
    <!--
      Keep the informational version free of the "+<commit sha>" suffix the SDK appends, because
      it lands in the executable's ProductVersion resource. The SignPath artifact configuration
      pins ProductVersion to the version passed into the release workflow, and SignPath Foundation
      requires that restriction to be enforced, so a per-commit suffix would reject every signing
      request. This leaves VersionSuffix alone, so the "dev" marker local builds rely on survives.
      AboutInfo.ReadVersion strips the commit suffix anyway, so nothing in the UI changes.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Required by the LibraryImport source generator used for the UIPI and taskbar interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      WFO0003 tells WinForms apps to move DPI settings out of the manifest. This is a WPF app that
      only references WinForms for NotifyIcon, and WPF requires DPI awareness to be declared in the
      manifest, so the guidance does not apply.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ApplicationIcon only stamps the Win32 icon onto the executable. The same file is embedded as a
      resource so the windows and the tray notification can load it through a pack URI.
    -->
    <Resource Include="Assets\HyperDrop.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperDrop.Core\HyperDrop.Core.csproj" />
  </ItemGroup>

</Project>
