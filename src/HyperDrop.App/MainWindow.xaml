<Window x:Class="HyperDrop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:HyperDrop.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="HyperDrop"
        Icon="/Assets/HyperDrop.ico"
        Height="640"
        Width="860"
        MinHeight="520"
        MinWidth="680"
        AllowDrop="True"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}"
                         ProgressValue="{Binding OverallProgress}" />
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Virtual machine selection -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Virtual machine"
                               Style="{StaticResource FieldLabel}" />

                    <ComboBox Grid.Row="1" Grid.Column="0"
                              ItemsSource="{Binding VirtualMachines}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedVmId, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding State, StringFormat=' — {0}'}"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Grid.Row="1" Grid.Column="1"
                            Content="Refresh"
                            Margin="8,0,12,0"
                            Command="{Binding RefreshCommand}" />

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="Transfer method"
                               Style="{StaticResource FieldLabel}" />

                    <ComboBox Grid.Row="1" Grid.Column="2"
                              ItemsSource="{Binding TransferMethodOptions}"
                              DisplayMemberPath="Display"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Method, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Destination and options -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Destination folder inside the guest"
                                   Style="{StaticResource FieldLabel}" />

                        <TextBox Grid.Row="1" Grid.Column="0"
                                 Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="Add files…" Click="OnAddFiles" Margin="0,0,6,0" />
                            <Button Content="Add folder…" Click="OnAddFolder" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox Content="Overwrite existing files"
                                  IsChecked="{Binding OverwriteExisting, Mode=TwoWay}"
                                  Margin="0,0,20,0" />
                        <CheckBox Content="Create destination folders"
                                  IsChecked="{Binding CreateFullPath, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding GuestServiceStatus}"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                        <Button Content="Enable"
                                Style="{StaticResource LinkButton}"
                                Margin="8,0,0,0"
                                Command="{Binding EnableGuestServiceCommand}"
                                Visibility="{Binding CanEnableGuestService, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Transfers -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox ItemsSource="{Binding Transfers}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TransferItemViewModel}">
                                <Border Background="Transparent" Padding="10,8" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="{Binding RelativePath}"
                                                   Style="{StaticResource CaptionText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ShowsRelativePath, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   MinWidth="64"
                                                   TextAlignment="Right" />

                                        <StackPanel Grid.Row="0" Grid.Column="2"
                                                    Grid.RowSpan="2"
                                                    Orientation="Horizontal"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Button Content="Retry"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.RetryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                            <Button Content="Cancel"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                     Style="{StaticResource ThinProgressBar}"
                                                     Margin="0,6,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsIndeterminate}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="{Binding DetailText}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding DetailText, Converter={StaticResource StringToVisibility}}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="{Binding ErrorText}"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding HasTransfers, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding DropHintText}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="You can also use Add files… or press Ctrl+V"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Row="0" Grid.Column="0"
                             Style="{StaticResource ThinProgressBar}"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding OverallProgress, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Visibility="{Binding HasTransfers, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Cancel all"
                            Margin="0,0,6,0"
                            Command="{Binding CancelAllCommand}"
                            Visibility="{Binding HasActiveTransfers, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Clear completed"
                            Command="{Binding ClearCompletedCommand}"
                            Visibility="{Binding HasTransfers, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding OverallText}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           Visibility="{Binding OverallText, Converter={StaticResource StringToVisibility}}" />

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Margin="12,8,0,0"
                           MaxWidth="420"
                           TextAlignment="Right"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- Drag overlay, shown while something is dragged over the window -->
        <Border Background="#E6F1F7FD"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="10"
                Margin="10"
                IsHitTestVisible="False"
                Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding DropHintText}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DestinationPath, StringFormat='Release to copy into {0}'}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

</Window>
