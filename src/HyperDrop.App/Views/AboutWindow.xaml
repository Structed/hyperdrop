<Window x:Class="HyperDrop.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About HyperDrop"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <StackPanel Margin="20">

        <TextBlock Text="HyperDrop"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <TextBlock x:Name="VersionText"
                   Style="{StaticResource CaptionText}"
                   Margin="0,2,0,0" />

        <TextBlock x:Name="TaglineText"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Runtime"
                           Style="{StaticResource CaptionText}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="RuntimeText"
                           Grid.Row="0" Grid.Column="1"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Windows"
                           Style="{StaticResource CaptionText}"
                           Margin="0,0,12,4" />
                <TextBlock x:Name="OsText"
                           Grid.Row="1" Grid.Column="1"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Process"
                           Style="{StaticResource CaptionText}"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="ProcessText"
                           Grid.Row="2" Grid.Column="1"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <TextBlock x:Name="CreditText"
                   Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Source and issues"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
            <Button x:Name="ProjectLink"
                    Style="{StaticResource LinkButton}"
                    Margin="4,0,0,0"
                    Click="OnOpenProject" />
        </StackPanel>

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy details" Click="OnCopyDetails" Margin="0,0,8,0" MinWidth="88" />
                <Button Content="Close" IsDefault="True" IsCancel="True" Click="OnClose"
                        Style="{StaticResource AccentButton}" MinWidth="88" />
            </StackPanel>
        </Grid>

    </StackPanel>

</Window>
