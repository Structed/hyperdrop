<Window x:Class="HyperDrop.App.Views.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to guest"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">

    <StackPanel Margin="20">

        <TextBlock x:Name="PromptText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UserNameBox" Margin="0,0,0,12" />

        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,6" />

        <TextBlock Style="{StaticResource CaptionText}"
                   TextWrapping="Wrap"
                   Text="Credentials are used only to open a PowerShell Direct session and are never written to disk."
                   Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,8,0" MinWidth="88" />
            <Button Content="Connect" IsDefault="True" Click="OnConnect"
                    Style="{StaticResource AccentButton}" MinWidth="88" />
        </StackPanel>

    </StackPanel>

</Window>
