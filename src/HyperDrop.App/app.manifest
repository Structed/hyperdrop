<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="HyperDrop.app" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          Deliberately NOT requireAdministrator.

          Hyper-V WMI (root\virtualization\v2) is gated on membership of the local
          "Hyper-V Administrators" group (S-1-5-32-578), which UAC does not strip from the
          filtered token. Elevation is one way in, not the requirement it was assumed to be.

          Elevating would put the window at high integrity, and Windows UIPI blocks OLE
          drag & drop from medium-integrity Explorer across that boundary. That cannot be
          worked around: ChangeWindowMessageFilterEx only opens up the legacy WM_DROPFILES
          protocol, not the OLE one WPF uses. Running as the invoker is what makes drag &
          drop work at all. See Interop/WindowDropTarget.cs for the fallback used when the
          app is launched elevated anyway.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

</assembly>
