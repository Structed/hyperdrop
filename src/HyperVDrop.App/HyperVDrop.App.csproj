<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is pulled in purely for NotifyIcon (tray balloon) and the folder browser. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HyperVDrop</AssemblyName>
    <RootNamespace>HyperVDrop.App</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Required by the LibraryImport source generator used for the UIPI and taskbar interop. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      WFO0003 tells WinForms apps to move DPI settings out of the manifest. This is a WPF app that
      only references WinForms for NotifyIcon, and WPF requires DPI awareness to be declared in the
      manifest, so the guidance does not apply.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HyperVDrop.Core\HyperVDrop.Core.csproj" />
  </ItemGroup>

</Project>
